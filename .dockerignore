# ============================================================
# Root Docker ignore file for monorepo
# ============================================================

# Node
node_modules
npm-debug.log
pnpm-debug.log

# Environment
.env
.env.local
.env.*.local
.env.production

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build outputs (we rebuild inside Docker)
dist
build
.next

# Test files
coverage
.nyc_output
test
*.spec.ts

# Logs
logs
*.log

# Prisma (we copy only the schema)
prisma/*.sqlite
prisma/migrations/*.sqlite

# Frontend (not needed for backend build)
frontend/