// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String?
  avatar       String?  // URL to avatar image
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  emailVerified Boolean @default(false)
  refreshToken String?  @unique   // stores the current valid refresh token

  // Email verification fields
  verificationToken      String?  @unique
  verificationTokenExpiry DateTime?
  
  // Password reset fields
  resetToken      String?  @unique
  resetTokenExpiry DateTime?
  
  // 2FA fields
  twoFactorSecret    String?   // Base32 secret for TOTP
  isTwoFactorEnabled Boolean   @default(false)
  backupCodes        String?   // JSON array of hashed backup codes

  // Audit log relation (opposite side of AuditLog.user)
  auditLogs    AuditLog[]

  // ✅ NEW: One-to-Many relationship with Notes
  notes        Note[]     // A user can have many notes

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime? // Soft-delete marker; null = active, non-null = deleted

  @@index([email])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  resource  String?  // e.g., 'User', 'Role'
  resourceId String? @map("resource_id")
  details   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ✅ NEW MODEL: Notes Management System
model Note {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)  // Required - max 255 chars
  content     String?  @db.Text          // Optional - supports Markdown/rich text
  color       String?  @db.VarChar(50)   // Optional - hex color code or color name (e.g., '#f9f9f9', 'yellow')
  isFavorite  Boolean  @default(false)   // Pin/favorite notes for quick access
  isArchived  Boolean  @default(false)   // Hide notes without deleting them
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Key: Each note belongs to exactly one user
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Database Indexes for Performance
  @@index([userId])                    // Speed up queries filtering by user
  @@index([userId, isArchived])        // Speed up filtering active vs archived notes
  @@index([userId, isFavorite])        // Speed up filtering favorite notes
  
  @@map("notes")
}

enum Role {
  ADMIN
  USER
}