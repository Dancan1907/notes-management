# JWT
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production"

# App
NODE_ENV="development"
PORT="3001"

# Redis (for rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=template:

# ✅ Resend Email Configuration
RESEND_API_KEY=""  # Replace with your actual Resend API key
EMAIL_FROM="onboarding@resend.dev"  # Use your verified domain or @resend.dev
EMAIL_FROM_NAME="notes-management"
FRONTEND_URL="http://localhost:3000"

# ✅ Real Admin Account (for production seeding)
REAL_ADMIN_PASSWORD="YourStrongPassword123!"  # Set your real admin password

# Old Email Configuration (Keep for reference, but Resend will override)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
